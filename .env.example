# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── WhatsApp Cloud API (Primary phone OTP) ─────────────────────────────────
# Get these from Meta Business Manager → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxx...
WHATSAPP_VERIFY_TOKEN=your-random-webhook-verify-string
WHATSAPP_OTP_TEMPLATE_NAME=otp_verification

# ─── Firebase Authentication (SMS OTP fallback) ─────────────────────────────
# Get this from Firebase Console → Project Settings → General → Web API Key
FIREBASE_WEB_API_KEY=AIzaSy...

# ─── Resend (Email OTP) ─────────────────────────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── Payments ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_SECRET_TOKEN=
ADMIN_WHATSAPP_NUMBER=+919876543210

